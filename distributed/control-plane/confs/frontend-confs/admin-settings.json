{
  "app": {
    "context": "/admin",
    "customUrl": {
      "enabled": false,
      "forwardedHeader": "X-Forwarded-For"
    },
    "origin": {
      {{- if .Values.kubernetes.gatewayAPI.controlPlane.enabled -}}
      "host": "{{ .Values.kubernetes.gatewayAPI.controlPlane.internalHostname }}"
      {{- else if .Values.kubernetes.ingress.controlPlane.enabled -}}
      "host": "{{ .Values.kubernetes.ingress.controlPlane.internalHostname }}"
      {{- else -}}
      "host": "localhost"
      {{- end -}}
    },
    "workflows": {
      "limit": 30
    },
    "feedback": {
      "enable": false,
      "serviceURL": ""
    },
    "singleLogout": {
      "enabled": true,
      "timeout": 2000
    },
    "logoutSessionStateAppender" : "OIDC" ,
    "docUrl": "https://apim.docs.wso2.com/en/4.7.0/"
  }
}
